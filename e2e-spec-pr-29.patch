diff --git a/cypress/e2e/tests/features/message-summary.spec.ts b/cypress/e2e/tests/features/message-summary.spec.ts
new file mode 100644
index 0000000..86fa5db
--- /dev/null
+++ b/cypress/e2e/tests/features/message-summary.spec.ts
@@ -0,0 +1,152 @@
+import HomePagePo from '@rancher/cypress/e2e/po/pages/home.po';
+import ChatPo from '@/cypress/e2e/po/chat.po';
+import { SlidingBadgePo } from '@/cypress/e2e/po/hook.po';
+
+describe('Feature: message-summary', () => {
+  const chat = new ChatPo();
+
+  beforeEach(() => {
+    cy.login();
+    HomePagePo.goTo();
+  });
+
+  afterEach(() => {
+    cy.cleanChatHistory();
+  });
+
+  it('Test 1: Badge message shows summary content with "See More" button', () => {
+    const homePage = new HomePagePo();
+    const statusColumn = homePage.list().resourceTable().sortableTable().row(0).column(0);
+    const slidingBadge = new SlidingBadgePo(statusColumn);
+
+    cy.enqueueLLMResponse({ text: 'Cluster analysis complete.', chunkSize: 10 });
+    slidingBadge.click();
+
+    chat.isOpen();
+    chat.getMessage(2).isCompleted();
+
+    chat.getMessage(1).containsText('Please analyse the Cluster');
+    chat.getMessage(1).containsText('See More');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('not.exist');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-summary-test-1-badge-shows-summary');
+  });
+
+  it('Test 2: Clicking "See More" expands the full message text', () => {
+    const homePage = new HomePagePo();
+    const statusColumn = homePage.list().resourceTable().sortableTable().row(0).column(0);
+    const slidingBadge = new SlidingBadgePo(statusColumn);
+
+    cy.enqueueLLMResponse({ text: 'Cluster analysis complete.', chunkSize: 10 });
+    slidingBadge.click();
+
+    chat.isOpen();
+    chat.getMessage(2).isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] .inline-button').contains('See More').click();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('exist')
+      .and('be.visible');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('have.class', 'chat-msg-user-expanded');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] .inline-button').should('contain.text', 'See Less');
+
+    chat.getMessage(1).containsText('Please analyse the Cluster');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-summary-test-2-expanded-full-message');
+  });
+
+  it('Test 3: Clicking "See Less" collapses back to summary', () => {
+    const homePage = new HomePagePo();
+    const statusColumn = homePage.list().resourceTable().sortableTable().row(0).column(0);
+    const slidingBadge = new SlidingBadgePo(statusColumn);
+
+    cy.enqueueLLMResponse({ text: 'Cluster analysis complete.', chunkSize: 10 });
+    slidingBadge.click();
+
+    chat.isOpen();
+    chat.getMessage(2).isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] .inline-button').contains('See More').click();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] .inline-button').contains('See Less').click();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('not.exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] .inline-button').should('contain.text', 'See More');
+
+    chat.getMessage(1).containsText('Please analyse the Cluster');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-summary-test-3-collapsed-back-to-summary');
+  });
+
+  it('Test 4: Summary HTML renders resource name in bold', () => {
+    const homePage = new HomePagePo();
+    const statusColumn = homePage.list().resourceTable().sortableTable().row(0).column(0);
+    const slidingBadge = new SlidingBadgePo(statusColumn);
+
+    cy.enqueueLLMResponse({ text: 'Cluster analysis complete.', chunkSize: 10 });
+    slidingBadge.click();
+
+    chat.isOpen();
+    chat.getMessage(2).isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] strong').should('exist');
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-1"] strong').should('contain.text', 'local');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-summary-test-4-bold-resource-name');
+  });
+
+  it('Test 5: Regular typed user messages show full content without "See More"', () => {
+    chat.open();
+    chat.getMessage(1).isCompleted();
+
+    cy.enqueueLLMResponse({ text: 'Got it.' });
+    chat.sendMessage('Hello Liz');
+
+    chat.getMessage(3).isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-2"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('exist')
+      .and('contain.text', 'Hello Liz');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-2"] .inline-button').should('not.exist');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-summary-test-5-regular-message-no-see-more');
+  });
+
+  it('Test 6: AI assistant response message has no "See More" button', () => {
+    const homePage = new HomePagePo();
+    const statusColumn = homePage.list().resourceTable().sortableTable().row(0).column(0);
+    const slidingBadge = new SlidingBadgePo(statusColumn);
+
+    cy.enqueueLLMResponse({ text: 'Cluster analysis complete.', chunkSize: 10 });
+    slidingBadge.click();
+
+    chat.isOpen();
+    chat.getMessage(2).isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-2"] .inline-button').should('not.exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-2"] [data-testid="rancher-ai-ui-chat-message-formatted-content"]')
+      .should('exist')
+      .and('be.visible');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-summary-test-6-ai-message-no-see-more');
+  });
+});
