+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('[data-testid^="rancher-ai-ui-chat-message-action-button-"]')
+      .should('have.length', 8);
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-actions-more')
+      .should('contain.text', 'Show Less');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-7-expand-remaining-actions');
+  });
+
+  it('Test 8: Clicking "Show Less" collapses remaining actions', () => {
+    chat.open();
+
+    const welcomeMessage = chat.getMessage(1);
+
+    welcomeMessage.isCompleted();
+
+    const resources = Array.from({ length: 8 }, (_, i) => ({
+      kind:      'Pod',
+      namespace: 'default',
+      name:      `pod-${ i + 1 }`,
+      cluster:   'local',
+      type:      'pod',
