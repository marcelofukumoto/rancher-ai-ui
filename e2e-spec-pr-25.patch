+import HomePagePo from '@rancher/cypress/e2e/po/pages/home.po';
+import ChatPo from '@/cypress/e2e/po/chat.po';
+
+describe('Feature: message-source-links', () => {
+  const chat = new ChatPo();
+
+  beforeEach(() => {
+    cy.login();
+    HomePagePo.goTo();
+  });
+
+  afterEach(() => {
+    cy.cleanChatHistory();
+  });
+
+  it('Test 1: Source links section is absent when response has no source link tags', () => {
+    chat.open();
+
+    const welcomeMessage = chat.getMessage(1);
+
+    welcomeMessage.isCompleted();
+
+    cy.enqueueLLMResponse({ text: 'Here is a plain response with no source links.' });
+
+    chat.sendMessage('Give me a plain response');
+
+    const userMessage = chat.getMessage(2);
+
+    userMessage.containsText('Give me a plain response');
+
+    const resultMessage = chat.getMessage(3);
+
+    resultMessage.isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-source-container')
+      .should('not.exist');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-1-no-source-links');
+  });
+
+  it('Test 2: Source links section collapses when chevron is clicked', () => {
+    chat.open();
+
+    const welcomeMessage = chat.getMessage(1);
+
+    welcomeMessage.isCompleted();
+
+    cy.enqueueLLMResponse({
+      text: [
+        'Here are some docs: ',
+        '<mcp-doclink>https://www.rancher.com/why-rancher</mcp-doclink>',
+        '<mcp-doclink>https://www.rancher.com/support/</mcp-doclink>',
+      ],
+    });
+
+    chat.sendMessage('Give me some documentation links');
+
+    const userMessage = chat.getMessage(2);
+
+    userMessage.containsText('Give me some documentation links');
+
+    const resultMessage = chat.getMessage(3);
+
+    resultMessage.isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-tags')
+      .should('exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-label .icon-chevron-up')
+      .should('exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-label .icon')
+      .click();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-tags')
+      .should('not.exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-label .icon-chevron-down')
+      .should('exist');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-2-collapse-source-links');
+  });
+
+  it('Test 3: Source links section re-expands after a second chevron click', () => {
+    chat.open();
+
+    const welcomeMessage = chat.getMessage(1);
+
+    welcomeMessage.isCompleted();
+
+    cy.enqueueLLMResponse({
+      text: [
+        'Here are some docs: ',
+        '<mcp-doclink>https://www.rancher.com/why-rancher</mcp-doclink>',
