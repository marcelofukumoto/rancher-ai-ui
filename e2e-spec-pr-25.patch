+    const userMessage = chat.getMessage(2);
+
+    userMessage.containsText('Give me a link');
+
+    const resultMessage = chat.getMessage(3);
+
+    resultMessage.isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-source-link-0"]').click();
+
+    cy.get('@windowOpen').should('have.been.calledOnceWith', 'https://www.rancher.com/why-rancher', '_blank');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-4-click-source-link');
+  });
+
