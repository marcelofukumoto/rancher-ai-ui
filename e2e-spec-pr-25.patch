+      .should('have.length', 7);
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-actions-more')
+      .should('contain.text', 'and 1 more resource');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-8-collapse-remaining-actions');
