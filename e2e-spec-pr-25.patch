+
+    userMessage.containsText('Show me 8 pod resources');
+
+    const resultMessage = chat.getMessage(3);
+
+    resultMessage.isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('[data-testid^="rancher-ai-ui-chat-message-action-button-"]')
+      .should('have.length', 7);
