+    resultMessage.isCompleted();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-label .icon')
+      .click();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-tags')
+      .should('not.exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-label .icon')
+      .click();
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-tags')
+      .should('exist');
+
+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-source-label .icon-chevron-up')
+      .should('exist');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-3-expand-source-links');
+  });
+
+  it('Test 4: Clicking a source link opens the URL in a new tab', () => {
+    cy.window().then((win) => {
+      cy.stub(win, 'open').as('windowOpen');
+    });
+
+    chat.open();
+
+    const welcomeMessage = chat.getMessage(1);
+
+    welcomeMessage.isCompleted();
+
+    cy.enqueueLLMResponse({
+      text: [
+        'Check out this link: ',
+        '<mcp-doclink>https://www.rancher.com/why-rancher</mcp-doclink>',
+      ],
+    });
