+    cy.get('[data-testid="rancher-ai-ui-chat-message-box-3"]')
+      .find('.chat-msg-actions-more')
+      .should('be.visible')
+      .and('contain.text', 'and 1 more resource');
+
+    cy.wait(500);
+    cy.get('[data-testid="rancher-ai-ui-chat-container"]').screenshot('message-source-links-test-6-show-more-actions');
+  });
+
+  it('Test 7: Clicking "And N more resource(s)" reveals all actions', () => {
+    chat.open();
+
+    const welcomeMessage = chat.getMessage(1);
+
+    welcomeMessage.isCompleted();
+
+    const resources = Array.from({ length: 8 }, (_, i) => ({
+      kind:      'Pod',
+      namespace: 'default',
+      name:      `pod-${ i + 1 }`,
